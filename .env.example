# Copy this file to ".env" and fill in what you need. All values are optional.

PORT=3000

# Serve the site under a sub-path, e.g. https://virashalabs.online/studioapp
# Leave empty to serve at the site root.
BASE_PATH=

# Initial admin password (only used the first time the database is created).
# Change it later from Admin -> Settings.
ADMIN_PASSWORD=admin123

# Keeps admins logged in across server restarts. Use any long random text.
SESSION_SECRET=change-me-to-a-long-random-string

# Email notifications (booking alerts to the owner, confirmations to customers).
# Without these, emails are printed in the server console instead of being sent.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=you@gmail.com, SMTP_PASS=<a Gmail "App password">
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Riff Room Studios <bookings@example.com>"
